
//named.conf.local
// A records. Change the domain to your actual one.
   zone "anderson237.com" {
       type master;
       file "/etc/bind/zones/db.anderson237.com";
   };

//PTR records. Use your actual IP.
   zone "122.168.192.in-addr.arpa" {
       type master;
       file "/etc/bind/zones/db.192.168.122";
   };
